# Server
PORT=4000
NODE_ENV=development

# Database (Supabase/Neon free-tier Postgres connection string)
DATABASE_URL=postgres://user:password@host:5432/botxchange

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Encryption key for storing broker passwords (must be exactly 32 characters)
ENCRYPTION_KEY=replace_with_32_char_secret_key!!

# Cron protection (used by cron-job.org to call /cron/run-bots)
CRON_SECRET=replace_with_a_long_random_string

# MetaApi.cloud (leave blank to run in SIMULATED broker mode for local testing)
METAAPI_TOKEN=

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
